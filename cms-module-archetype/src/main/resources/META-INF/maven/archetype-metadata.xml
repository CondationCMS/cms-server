<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor
        xmlns="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.2.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.2.0 https://maven.apache.org/xsd/archetype-descriptor-1.2.0.xsd"
        name="cms-module">
    <requiredProperties>
        <requiredProperty key="moduleName">
            <defaultValue>${artifactId}</defaultValue>
        </requiredProperty>
    </requiredProperties>
    <fileSets>
        <fileSet filtered="true" packaged="false">
            <directory></directory>
            <includes>
                <include>pom.xml</include>
            </includes>
        </fileSet>
        <fileSet filtered="true" packaged="false">
            <directory>api</directory>
            <includes>
                <include>pom.xml</include>
            </includes>
        </fileSet>
        <fileSet filtered="true" packaged="true">
            <directory>api/src/main/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>
        <fileSet filtered="true" packaged="false">
            <directory>module</directory>
            <includes>
                <include>pom.xml</include>
                <include>module.properties</include>
                <include>src/main/assembly/assembly.xml</include>
            </includes>
        </fileSet>
        <fileSet filtered="true" packaged="true">
            <directory>module/src/main/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>
        <fileSet filtered="true" packaged="false">
            <directory>module/cms-home</directory>
            <includes>
                <include>server.toml</include>
                <include>hosts/*/site.toml</include>
            </includes>
        </fileSet>
        <fileSet filtered="false" packaged="false">
            <directory>module/cms-home</directory>
            <includes>
                <include>themes/.gitkeep</include>
                <include>hosts/*/content/**</include>
                <include>hosts/*/templates/**</include>
            </includes>
        </fileSet>
        <fileSet filtered="false" packaged="false">
            <directory>.mvn</directory>
            <includes>
                <include>jvm.config</include>
            </includes>
        </fileSet>
    </fileSets>
</archetype-descriptor>
